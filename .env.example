# ─────────────────────────────────────────────────────────────────────────────
# B2B Chemical Auction Platform — environment variables
# Copy to `.env.local` for local dev. Set the same keys in Vercel for production.
# NEVER commit real secrets. All secrets are read server-side only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (DB + Auth + Storage + Realtime) ────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection for Drizzle migrations (Project Settings → Database).
# Use the pooler/session connection string. URL-encode special chars in the password.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# ── GST verification provider ────────────────────────────────────────────────
# `mock` = MockGstProvider (deterministic fake data — no network, no key).
# `gstincheck` = gstincheck.co.in (LIVE provider — simple key, 20 free credits).
# `cashfree` = Cashfree Verification Suite. `surepass` = Surepass.
GST_PROVIDER=mock

# gstincheck.co.in — GET https://sheet.gstincheck.co.in/check/{key}/{gstin}
GSTINCHECK_API_KEY=
# GSTINCHECK_BASE_URL=https://sheet.gstincheck.co.in

# Cashfree GSTIN verify (https://www.cashfree.com/docs/api-reference/vrs/v2/gstin/verify-gstin)
# Dashboard → Developers → API Keys. CASHFREE_ENV: `sandbox` (default) or `production`.
# Note: Cashfree may require IP whitelisting — Vercel egress IPs are dynamic, so use
# a static-IP path or ask Cashfree to disable IP allowlisting for the key.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# Optional explicit override (otherwise derived from CASHFREE_ENV):
# CASHFREE_BASE_URL=https://sandbox.cashfree.com

# Surepass (alternative vendor)
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://kyc-api.surepass.io

# ── Resend (transactional email) ─────────────────────────────────────────────
# With no key, the app falls back to a console-log email transport (dev-safe).
# EMAIL_FROM must be an address on a Resend-VERIFIED domain to reach non-owner inboxes.
RESEND_API_KEY=
EMAIL_FROM="Chemical Auction <notify@chemibid.com>"

# ── Contact verification (email + phone OTP) ─────────────────────────────────
# Server pepper for HMAC-hashing OTP codes. Long random string (>=16 chars; 32
# bytes recommended). Generate: `openssl rand -hex 32`. If unset, the app falls
# back to CRON_SECRET as the pepper, so email verification works without a new
# env var — but a dedicated secret is preferred (purpose separation).
OTP_HMAC_SECRET=
# Phone-OTP SMS provider: `mock` (dev — logs the code to the server console, never
# delivers; refuses to run in production) or `msg91` (India, live SMS). Live phone
# OTP also needs India DLT registration (TRAI) on the MSG91 template.
SMS_PROVIDER=mock
# MSG91 (https://msg91.com) — DLT-approved OTP template id + auth key.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Google Maps (Service Providers Hub — pickup/drop validation) ─────────────
# Optional. With a key set, transport pickup/drop addresses MUST be picked from
# Google Places suggestions (stored with place_id for routing). Without a key,
# the form falls back to free-text addresses. Enable "Places API" + "Maps
# JavaScript API" on the key. Browser key — restrict by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── PubChem (CAS → name lookup) ──────────────────────────────────────────────
# Public PUG-REST; no key. Results cached in cas_cache. Override base URL if proxying.
PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug

# ── Cron security ────────────────────────────────────────────────────────────
# Shared secret guarding /api/cron/* routes. Vercel Cron sends it as a Bearer token.
CRON_SECRET=replace-with-a-long-random-string

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails seeded as Platform Operators on first run (operator console).
OPERATOR_EMAILS=ops@twoclicksmedia.example
